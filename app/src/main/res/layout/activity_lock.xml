<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lock_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/lock_bg"
    android:paddingHorizontal="24dp"
    android:paddingBottom="16dp"
    android:clipToPadding="false">

    <!-- 顶部整体垂直居中辅助 -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="0.12" />

    <!-- 锁图标 -->
    <ImageView
        android:id="@+id/iv_lock_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_lock_lock"
        android:alpha="0.5" />

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/tv_lock_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="请绘制解锁图案"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />

    <!-- 图案锁 -->
    <com.example.mybill.view.PatternLockView
        android:id="@+id/pattern_lock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp" />

    <!-- PIN 输入区域 -->
    <LinearLayout
        android:id="@+id/layout_pin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <!-- PIN 圆点显示 -->
        <LinearLayout
            android:id="@+id/layout_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_pin_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/expense_red"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <!-- 数字键盘 3x4，按钮宽度自适应，增大触控区域 -->
        <LinearLayout
            android:id="@+id/layout_keypad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_1"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="1" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_2"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="2" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_3"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="3" android:textSize="26sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_4"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="4" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_5"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="5" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_6"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="6" android:textSize="26sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_7"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="7" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_8"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="8" android:textSize="26sp" android:textColor="@color/text_primary" />
                <View android:layout_width="12dp" android:layout_height="1dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_9"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="9" android:textSize="26sp" android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <View
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_0"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="0" android:textSize="26sp" android:textColor="@color/text_primary" />

                <View android:layout_width="12dp" android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_num_del"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp" android:layout_height="76dp"
                    android:layout_weight="1" android:minWidth="80dp" android:maxWidth="120dp"
                    android:text="⌫" android:textSize="20sp" android:textColor="#757575" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部切换按钮 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_switch_mode"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:text="切换到密码解锁"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="8dp" />

</LinearLayout>
