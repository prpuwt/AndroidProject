<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:minHeight="280dp">

    <!-- 提示文字 -->
    <TextView
        android:id="@+id/tv_setup_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请绘制解锁图案（至少4个点）"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- 图案锁绘制区域 -->
    <com.example.mybill.view.PatternLockView
        android:id="@+id/pattern_setup"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:visibility="visible" />

    <!-- PIN 设置区域 -->
    <LinearLayout
        android:id="@+id/layout_pin_setup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layout_setup_pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_setup_pin_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/expense_red"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_1"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="1" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_2"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="2" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_3"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="3" android:textSize="20sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_4"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="4" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_5"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="5" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_6"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="6" android:textSize="20sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_7"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="7" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_8"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="8" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_9"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="9" android:textSize="20sp" android:textColor="@color/text_primary" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <View android:layout_width="64dp" android:layout_height="64dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_0"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="0" android:textSize="20sp" android:textColor="@color/text_primary" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_setup_pin_del"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="64dp" android:layout_height="64dp"
                    android:text="⌫"
                    android:textSize="18sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
